# ==============================================================================
# FITORA ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure your secret credentials.
# ==============================================================================

# Django Secret Key (Generate a random string for production)
SECRET_KEY=django-insecure-fitora-super-secret-development-key-change-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Relational Database URL (PostgreSQL in production, SQLite fallback locally if empty)
# Example: postgresql://username:password@hostname:5432/fitora_db
DATABASE_URL=

# MongoDB Atlas Connection URI for chat logs and feedback
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# AI Assistant LLM API Key (e.g., Gemini or OpenAI compatible)
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Third-party Nutrition API Key (optional for Open Food Facts, or your API key)
NUTRITION_API_KEY=
